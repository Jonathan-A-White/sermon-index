# Runs sermon-index-brookfield-refresh.service every day at 18:00 UTC (1 pm
# New York in winter, 2 pm in summer), so a Morning RePhil episode, which airs
# on Mondays and Fridays in the morning, is on the list the same day. A run
# spends about 12 units of the YouTube Data API's 10,000 a day, and a daily
# refresh is also far inside YouTube's 30-day limit on keeping API data.
# For `systemctl --user`.
[Unit]
Description=Every day, regenerate Brookfield First's YouTube list and the Morning RePhil episodes

[Timer]
OnCalendar=*-*-* 18:00:00 UTC
# A host that was off at 18:00 runs the refresh when it wakes.
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
