# One run of scripts/refresh-brookfield.sh, as the user, then it exits: no
# daemon. Started by sermon-index-brookfield-refresh.timer. For `systemctl --user`.
#
# It reads the YouTube key from the vault (mw secrets get youtube_api_key) into
# the environment of one go run, regenerates sources/brookfield-first and
# data/morning-rephil.jsonl, commits and pushes them only if they changed, then
# loads sources/ into the live database (sermons load --all) and only then
# writes the stamp.
# The key is in no file and no unit. A failed run is mailed to the Mayor by
# OnFailure=.
[Unit]
Description=Sermon index: regenerate Brookfield First's YouTube list and commit it if it changed
After=network-online.target
Wants=network-online.target
OnFailure=mw-unit-failed@%n.service

[Service]
Type=oneshot
# PATH only (mw, go and git are found through it). The sermons command is not
# on it; the script reads the service's env file itself (DATABASE_URL) for the
# load, in a subshell the YouTube key never enters.
EnvironmentFile=-%h/.config/mw/dispatch.env
Environment=SERMONS=%h/.local/bin/sermons
WorkingDirectory=%h/sermon-index
ExecStart=/bin/sh %h/sermon-index/scripts/refresh-brookfield.sh

# Type=oneshot has no start timeout by default, and a hung fetch would then
# block every later run.
TimeoutStartSec=15min
